# GEMINI_API_KEY: Required for Gemini AI API calls (if configured).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Current web app URL
APP_URL="https://solostor.netlify.app"

# Netlify Frontend Environment Variables (Only public anon variables; no secrets)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Supabase Edge Functions Base URL (e.g. https://<project-ref>.supabase.co/functions/v1)
# Used by frontend to invoke Edge Functions safely
VITE_SUPABASE_FUNCTIONS_URL=""

# ==============================================================================
# SERVER-ONLY SECRETS (Set ONLY in Supabase Edge Function Secrets)
# DO NOT put these in Netlify, Git, or any frontend variable!
# ==============================================================================
# CJ_ACCESS_TOKEN: Your CJ Dropshipping Developer Access Token
# PAYMENT_WEBHOOK_SECRET: Secret for verifying generic payment gateway webhook signatures
# PAYMENT_PROVIDER: Name of payment gateway once chosen (e.g. moyasar, tap, stripe)
# ATLOS_API_SECRET: Merchant API secret key for verifying ATLOS crypto gateway webhooks (HMAC-SHA256)
# ATLOS_MERCHANT_ID: Merchant ID on atlos.io
# PAYMENTO_API_KEY: Paymento merchant API key for payment requests and server-side verification
# PAYMENTO_SECRET_KEY: Paymento store secret key for raw-body HMAC-SHA256 IPN verification
# Enable the store_settings.paymento_enabled switch only after the owner reviews the migration and configures both secrets.
# Invoke paymento-process-pending on a trusted schedule using a server-side service-role bearer.
# SUPABASE_SERVICE_ROLE_KEY: Supabase service role key (used inside Edge Functions only, never in frontend)
